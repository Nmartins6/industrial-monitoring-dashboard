{
  "name": "industrial-monitoring-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard de monitoramento em tempo real para uma máquina industrial.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": ">=11.11.0 <12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "prettier": "3.9.5",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3"
  }
}
