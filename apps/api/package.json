{
  "name": "@industrial-monitoring/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de monitoramento em tempo real para uma máquina industrial.",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "devDependencies": {
    "@industrial-monitoring/eslint-config": "workspace:*",
    "@industrial-monitoring/typescript-config": "workspace:*",
    "@jest/globals": "30.4.1",
    "@types/node": "^26.1.1",
    "jest": "30.4.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test:compile": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test:run": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --runInBand",
    "test": "pnpm test:compile && pnpm test:run",
    "test:coverage": "pnpm test:compile && NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --coverage --runInBand"
  }
}
