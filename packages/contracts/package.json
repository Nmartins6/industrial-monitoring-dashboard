{
  "name": "@industrial-monitoring/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contratos TypeScript compartilhados entre as aplicações do monorepo.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
