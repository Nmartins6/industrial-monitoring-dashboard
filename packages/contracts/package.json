    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-test.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@industrial-monitoring/eslint-config": "workspace:*",
    "@industrial-monitoring/typescript-config": "workspace:*"
  }
}
